{
  "name": "matlog",
  "version": "0.6.0",
  "private": true,
  "description": "A local-only BJJ training journal. One tap to log class, open mat, drilling or a comp; lovely ways to see your progress.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "tsc && vitest run && playwright test"
  },
  "repository": { "type": "git", "url": "git+https://github.com/parmsam/matlog.git" },
  "homepage": "https://parmsam.github.io/matlog/",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
}
